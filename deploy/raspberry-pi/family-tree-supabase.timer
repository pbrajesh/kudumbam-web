# Daily at 16:00 India time (IST), whatever time zone the Pi is set to (or soon after the Pi starts, if it was off then).
#   sudo systemctl enable --now family-tree-supabase.timer
#   systemctl list-timers family-tree-supabase.timer
[Unit]
Description=Daily copy of the family tree database to Supabase

[Timer]
OnCalendar=*-*-* 16:00 Asia/Kolkata
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
