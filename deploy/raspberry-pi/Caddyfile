# Caddy on the Raspberry Pi: serves the app and passes /api to the API server on this Pi.
# Copy to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy
#
# The first line of the site block below is the site's address:
#   - Behind Cloudflare Tunnel (recommended for a home network): keep  :80
#     cloudflared provides HTTPS and the public name; nothing is opened on your router.
#   - With port forwarding (80 and 443 to this Pi) and a domain pointing at your home IP: replace  :80  with the
#     domain, e.g.  family.example.com  — Caddy then fetches and renews an HTTPS certificate by itself.

{
	servers {
		# cloudflared runs on this Pi and passes on each visitor's address; trust it for that (and nothing else).
		trusted_proxies static 127.0.0.1/8 ::1
	}
}

:80 {
	encode zstd gzip

	# The API (Node, systemd service family-tree-api) only listens on this Pi.
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	# The app: real files when they exist, otherwise index.html so links like /t/<id> and /privacy open directly.
	handle {
		root * /opt/family-tree/app
		try_files {path} /index.html
		file_server

		# File names with a content hash (main-AB12CD34.js) never change: cache them for a year.
		@hashed path_regexp \-[A-Z0-9]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@page not path_regexp \.(js|css|woff2?|png|svg|ico|txt)$
		header @page Cache-Control "no-cache"
	}

	header {
		# Only this site's own code may run; it may talk to this site and to your Supabase project (sign-in).
		# If you move to another Supabase project, change the address below.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://vyzygojjbhxqcpknasmm.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	log {
		# Access log without query strings (they can contain an email address when deleting an account).
		output file /var/log/caddy/family-tree.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					delete confirm
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}
