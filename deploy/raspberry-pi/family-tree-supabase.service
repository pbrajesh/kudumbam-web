# Runs supabase-sync.sh once: copies the database to Supabase. Started every day at 16:00 IST by family-tree-supabase.timer.
# The Supabase connection string is in /etc/family-tree/supabase.env (root:postgres, mode 640), see the guide.
# Result: journalctl -u family-tree-supabase -n 20
[Unit]
Description=Copy the family tree database to Supabase
After=network-online.target postgresql.service family-tree-backup.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
EnvironmentFile=/etc/family-tree/supabase.env
ExecStart=/bin/sh /opt/family-tree/deploy/supabase-sync.sh
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
